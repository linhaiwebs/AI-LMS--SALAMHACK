# =============================================================================
# WiseAI Finance (知恵塾金融) - Environment Variables Template
# =============================================================================
# Copy this file to .env.local and fill in your actual values:
#   cp .env.example .env.local
#
# NEVER commit .env.local to version control.
# =============================================================================

# ------------------------------------------------------------------
# Clerk Authentication (REQUIRED)
# Get your keys at: https://dashboard.clerk.com/last-active?path=api-keys
# ------------------------------------------------------------------
# Public key (starts with pk_test_ or pk_live_)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Secret key (starts with sk_test_ or sk_live_)
CLERK_SECRET_KEY=

# Clerk page routes
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Post-authentication redirect URLs
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# ------------------------------------------------------------------
# Database - Neon PostgreSQL (REQUIRED)
# Get your connection string at: https://console.neon.tech/
# Format: postgresql://user:password@host/database?sslmode=require
# ------------------------------------------------------------------
NEXT_PUBLIC_DATABSE_CONNECTION_STRING=

# ------------------------------------------------------------------
# Google Gemini AI (REQUIRED)
# Get your API key at: https://aistudio.google.com/apikey
# ------------------------------------------------------------------
GEMINI_API_KEY=

# ------------------------------------------------------------------
# Inngest (OPTIONAL)
# Used for background job processing.
# The event key is currently hardcoded in app/inngest/client.js
# Sign up at: https://www.inngest.com/
# ------------------------------------------------------------------
# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=

# ------------------------------------------------------------------
# Server Port (OPTIONAL)
# Default: 3000
# Usage: PORT=8080 npm run dev  OR  PORT=8080 npm run start
# ------------------------------------------------------------------
PORT=3000
